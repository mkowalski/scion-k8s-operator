FROM docker.io/library/golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# CGO required: scionproto path storage uses mattn/go-sqlite3.
RUN CGO_ENABLED=1 go build -o /agent ./cmd/agent

FROM gcr.io/distroless/base-debian12
# The binary is capability-agnostic; privileges come from the pod spec. The
# agent currently runs privileged as root (see the render.go TODO): on
# RHCOS, NET_ADMIN-only nonroot fails on SELinux hostPath/tun denials and
# the root-owned state dir.
COPY --from=build /agent /agent
ENTRYPOINT ["/agent"]
