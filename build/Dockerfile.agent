FROM docker.io/library/golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# CGO required: scionproto path storage uses mattn/go-sqlite3.
RUN CGO_ENABLED=1 go build -o /agent ./cmd/agent

FROM gcr.io/distroless/base-debian12
# NET_ADMIN + /dev/net/tun are granted by the pod spec; binary itself is
# capability-agnostic. Runs as root only when the SCC requires it for tun.
COPY --from=build /agent /agent
ENTRYPOINT ["/agent"]
